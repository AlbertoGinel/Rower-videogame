{
  "name": "rower-ghost-race",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:fake-data": "node scripts/generate-fake-data.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run android:sync && cd android && JAVA_HOME=$HOME/.jdks/jdk-21.0.12.1+1 ANDROID_HOME=$HOME/Android/Sdk ./gradlew assembleDebug",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/core": "^8.5.2",
    "idb-keyval": "^6.2.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^7.6.9",
    "@vitejs/plugin-vue": "^5.0.4",
    "vite": "^5.1.6",
    "vite-plugin-pwa": "^0.19.8"
  }
}
